# Installed as /etc/stadtplaner/osm-sync.env (root:www-data, mode 0640).
# Database passwords belong in ~oklab/.pgpass (mode 0600), not in this file.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=open_city_map
PGUSER=osm
# Leer lassen, um die Rolle aus backend/.env zu ermitteln.
OSM_APPLICATION_DB_ROLE=

OSM_DATA_DIR=/data/stadtplaner
OSM_REPOSITORY=/opt/git/open-city-planner
OSM_BACKEND_DIR=/opt/git/open-city-planner/backend
OSM_OUTPUT_SCHEMA=osm_import
OSM_MIDDLE_SCHEMA=osm_middle
OSM_PREFIX=stadtplaner_osm
OSM_STYLE=/opt/git/open-city-planner/scripts/osm/osm.lua
OSM_PBF_URL=https://download.geofabrik.de/europe/germany/schleswig-holstein-latest.osm.pbf
OSM_PBF_MD5_URL=https://download.geofabrik.de/europe/germany/schleswig-holstein-latest.osm.pbf.md5
OSM_REPLICATION_URL=https://planet.openstreetmap.org/replication/minute
OSM_CACHE_MB=1024
OSM_MAX_DIFF_MB=100

# Coarse output guard only. Postprocessing clips against OSM relation DE-SH.
OSM_BBOX_WEST=7.5
OSM_BBOX_SOUTH=53.3
OSM_BBOX_EAST=11.6
OSM_BBOX_NORTH=55.2
