[Unit]
Description=Stadtplaner Flensburg statistics synchronization
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=stadtplaner
Group=stadtplaner
WorkingDirectory=/opt/stadtplaner/backend
EnvironmentFile=/opt/stadtplaner/backend/.env
ExecStart=/opt/stadtplaner/backend/.venv/bin/python -m app.cli.import_flensburg_statistics
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/stadtplaner/backend/data
