DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/open_city_map
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
LOG_LEVEL=INFO
LOG_FORMAT=json
APP_ENVIRONMENT=development
METRICS_ENABLED=true
METRICS_PATH=/metrics
OBSERVABILITY_TEXTFILE_DIR=
OTEL_ENABLED=false
OTEL_SERVICE_NAME=stadtplaner-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
# Komma-separierte deploy-time Modul-IDs. Leer lässt alle neuen Module deaktiviert.
ENABLED_MODULES=
# Explicitly removes built-in composition sources; installed enablement remains in modules.lock.
OCP_EXCLUDED_BUILTIN_MODULES=
# Generated by `python -m app.cli.modules env`; do not maintain installed paths manually.
OCP_ENABLED_INSTALLED_BACKEND_PATHS=
# Das Frontend-Inventar inklusive Versionen wird daraus mit
# ../scripts/backend-module-inventory --format env erzeugt und nicht separat gepflegt.
# Aktive Module verwenden ausschließlich OCP_MODULE_<MODULE_ID>_<SETTING>.
# Beispielwerte stehen in docs/modules/configuration.md; Secrets bleiben leer bzw. lokal.
MAP_PREVIEW_RENDERER_URL=http://127.0.0.1:3020
MAP_PREVIEW_RENDERER_TIMEOUT_SECONDS=20
MAP_PREVIEW_CACHE_DIR=data/map-previews
MAP_PREVIEW_STYLE_PATH=../frontend/public/map-styles/stadtplaner-light.json

# Development default only. Generate and persist a production value once with:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=development-only-change-me-32-bytes-minimum
JWT_ALGORITHM=HS256
JWT_ISSUER=http://localhost:8000
JWT_AUDIENCE=stadtplaner
OAUTH_STATE_SECRET=development-oauth-state-change-me-32-bytes
MFA_RECOVERY_PEPPER=development-recovery-pepper-change-me-32-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Very short window for harmless concurrent multi-tab rotation races.
REFRESH_TOKEN_REUSE_GRACE_SECONDS=5
REFRESH_RATE_LIMIT_ATTEMPTS=30
REFRESH_RATE_LIMIT_WINDOW_SECONDS=60
REFRESH_REQUIRE_ORIGIN=false
AUTH_RATE_LIMIT_BACKEND=memory
RATE_LIMIT_FAIL_CLOSED=false
RATE_LIMIT_MEMORY_MAX_KEYS=10000

# X-Forwarded-For is used only when the direct peer matches this IP/CIDR list.
TRUSTED_PROXIES=
EMAIL_VERIFICATION_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_MINUTES=60
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_PATH=/
AUTH_MFA_COOKIE_NAME=ocm_mfa_challenge

# TOTP/MFA. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=
MFA_CHALLENGE_EXPIRE_SECONDS=300
MFA_MAX_ATTEMPTS=5
MFA_TOTP_ISSUER="Stadtplaner - OK Lab Flensburg"
MFA_TOTP_VALID_WINDOW=1
MFA_RECOVERY_CODE_COUNT=10
MFA_SETUP_EXPIRE_SECONDS=600
REAUTH_MAX_AGE_SECONDS=600
# Production enforces this policy even if the value is accidentally false.
REQUIRE_MFA_FOR_SUPERUSERS=true
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Stadtplaner - OK Lab Flensburg
WEBAUTHN_ORIGIN=http://localhost:3000
WEBAUTHN_CHALLENGE_EXPIRE_SECONDS=300
WEBAUTHN_TIMEOUT_MS=60000
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.org
SMTP_FROM_NAME="OK Lab Flensburg"
SMTP_USE_TLS=true

# Recipient for messages submitted through /api/v1/contact.
CONTACT_TO_EMAIL=
CONTACT_TO_NAME="Stadtplaner / OK Lab Flensburg"
CONTACT_FORM_TOKEN_EXPIRE_MINUTES=30
CONTACT_FORM_MIN_SECONDS=2
CONTACT_IP_RATE_LIMIT_ATTEMPTS=5
CONTACT_EMAIL_RATE_LIMIT_ATTEMPTS=3
CONTACT_RATE_LIMIT_WINDOW_SECONDS=3600

# Optional Cloudflare Turnstile protection. Both keys are required when enabled.
CONTACT_TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# OAuth buttons are shown only when both values for a provider are set.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mastodon SSO is separate from the publishing token below. Generate the key with:
# .venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTODON_SSO_ENABLED=false
MASTODON_SSO_CLIENT_NAME=Stadtplaner
MASTODON_SSO_DEFAULT_INSTANCE=https://norden.social
MASTODON_SSO_ENCRYPTION_KEY=
MASTODON_SSO_TIMEOUT_SECONDS=10
MASTODON_SSO_STATE_TTL_SECONDS=600
MASTODON_SSO_REGISTRATION_BACKOFF_SECONDS=300

# Public backend origin used to construct provider callbacks; defaults to API_BASE_URL.
OAUTH_REDIRECT_BASE_URL=
AVATAR_UPLOAD_DIR=data/uploads
AVATAR_MAX_FILE_SIZE=5242880
UPLOAD_BODY_OVERHEAD_BYTES=65536
MAX_JSON_BODY_BYTES=2097152
POLYGON_PROPERTIES_MAX_BYTES=65536
PUBLIC_QUERY_TIMEOUT_MS=8000
PUBLIC_QUERY_RATE_LIMIT_ATTEMPTS=120
PUBLIC_QUERY_RATE_LIMIT_WINDOW_SECONDS=60
AI_SEARCH_ENABLED=false
AI_SEARCH_PROVIDER=groq
AI_SEARCH_MODEL=
OPENAI_API_KEY=
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SECONDS=8
GROQ_MAX_RETRIES=1
GROQ_TEMPERATURE=0.1
ASSISTANT_QUERY_LOGGING=false
AVATAR_OUTPUT_SIZE=512
AVATAR_WEBP_QUALITY=85
MEDIA_BASE_URL=
# Optionaler eigener bzw. bewusst gewählter Nominatim-Dienst. Leer deaktiviert Reverse Geocoding.
NOMINATIM_BASE_URL=
NOMINATIM_USER_AGENT="OpenCityPlanner/0.1"
NOMINATIM_EMAIL=
NOMINATIM_TIMEOUT_SECONDS=5
NOMINATIM_CACHE_TTL_SECONDS=86400

# Lokale Tabelle osm_features bleibt die Primärquelle. Externen Fallback nur bewusst aktivieren.
OSM_EXTERNAL_FALLBACK_ENABLED=false
OVERPASS_API_URL=
OVERPASS_USER_AGENT="OpenCityPlanner/0.1 (https://stadtplaner.oklabflensburg.de)"
OVERPASS_TIMEOUT_SECONDS=8
OSM_LOOKUP_CACHE_TTL_SECONDS=3600
OSM_EXTERNAL_MIN_INTERVAL_SECONDS=1
OSM_LOOKUP_MAX_MATCHES=25
OSM_VIEWPORT_FEATURE_LIMIT=2000
OSM_VIEWPORT_LOW_ZOOM_FEATURE_LIMIT=800
OSM_VIEWPORT_MID_ZOOM_FEATURE_LIMIT=1200
OSM_VIEWPORT_POINT_FEATURE_LIMIT=1500
OSM_VIEWPORT_POLYGON_FEATURE_LIMIT=350
OSM_VIEWPORT_BUILDING_FEATURE_LIMIT=150

# Redis ist ein optionaler Shared-Read-Cache; PostgreSQL/PostGIS bleibt Source of Truth.
REDIS_ENABLED=true
REDIS_REQUIRED=false
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CONNECT_TIMEOUT=2
REDIS_SOCKET_TIMEOUT=2
REDIS_MAX_CONNECTIONS=40

# Pro Umgebung eindeutig setzen, z. B. stadtplaner:prod oder stadtplaner:test.
CACHE_PREFIX=stadtplaner:dev
CACHE_DEBUG_HEADERS=false
CACHE_LOCK_TTL_SECONDS=15
OSM_VIEWPORT_CACHE_TTL=1800
ANALYTICS_CACHE_TTL=600
ANALYSIS_AREA_CACHE_TTL=3600
WIKIDATA_API_URL=https://www.wikidata.org/w/api.php
WIKIDATA_USER_AGENT="Stadtplaner/1.0 (https://stadtplaner.oklabflensburg.de; OK Lab Flensburg)"
WIKIDATA_TIMEOUT_SECONDS=10
WIKIDATA_CACHE_TTL_SECONDS=604800
WIKIDATA_NEGATIVE_CACHE_TTL_SECONDS=86400
WIKIDATA_STALE_DAYS=90
WIKIDATA_SEARCH_LIMIT=8
STATISTICS_CACHE_TTL=3600
POLYGON_CACHE_TTL=60
COMPARABLE_CACHE_TTL=600
CACHE_PAYLOAD_WARNING_BYTES=2000000

DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=15

# Öffentlicher Zahlenspiegel der Stadt Flensburg. Keine Zugangsdaten erforderlich.
FLENSBURG_SUPERSET_BASE_URL=https://superset.flensburg.de
FLENSBURG_SUPERSET_DASHBOARD_ID=3b53ff0b-6e8c-435e-83f6-666f8a7cc158
FLENSBURG_SUPERSET_TIMEOUT_SECONDS=60

# Mastodon/Fediverse publishing. Access tokens stay backend-only and require write:statuses.
MASTODON_ENABLED=false
MASTODON_BASE_URL=https://norden.social
MASTODON_ACCESS_TOKEN=
MASTODON_ACCOUNT_URL=https://norden.social/@oklabflensburg
MASTODON_ACCOUNT_HANDLE=@oklabflensburg@norden.social
MASTODON_DEFAULT_VISIBILITY=public
MASTODON_AREA_UPDATES_ENABLED=true
MASTODON_AREA_UPDATE_DEBOUNCE_SECONDS=300
MASTODON_DRY_RUN=false
MASTODON_TIMEOUT_SECONDS=10
MASTODON_HASHTAGS=Flensburg,OpenData,Stadtplaner
MASTODON_MAX_ATTEMPTS=5
MASTODON_BOUNDARY_CHANGE_MIN_RATIO=0.01
MASTODON_SCREENSHOT_DIRECTORY=/data/stadtplaner-social
MASTODON_SCREENSHOT_TIMEOUT_SECONDS=30
