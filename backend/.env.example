DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/open_city_map
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
LOG_LEVEL=INFO
APP_ENVIRONMENT=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
JWT_SECRET_KEY=development-only-change-me-32-bytes-minimum
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Very short window for harmless concurrent multi-tab rotation races.
REFRESH_TOKEN_REUSE_GRACE_SECONDS=5
REFRESH_RATE_LIMIT_ATTEMPTS=30
REFRESH_RATE_LIMIT_WINDOW_SECONDS=60
EMAIL_VERIFICATION_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_MINUTES=60
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_PATH=/
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.org
SMTP_FROM_NAME="OK Lab Flensburg"
SMTP_USE_TLS=true

# Recipient for messages submitted through /api/v1/contact.
CONTACT_TO_EMAIL=
CONTACT_TO_NAME="Stadtplaner / OK Lab Flensburg"
CONTACT_FORM_TOKEN_EXPIRE_MINUTES=30
CONTACT_FORM_MIN_SECONDS=2
CONTACT_IP_RATE_LIMIT_ATTEMPTS=5
CONTACT_EMAIL_RATE_LIMIT_ATTEMPTS=3
CONTACT_RATE_LIMIT_WINDOW_SECONDS=3600

# Optional Cloudflare Turnstile protection. Both keys are required when enabled.
CONTACT_TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# OAuth buttons are shown only when both values for a provider are set.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public backend origin used to construct provider callbacks; defaults to API_BASE_URL.
OAUTH_REDIRECT_BASE_URL=
AVATAR_UPLOAD_DIR=data/uploads
AVATAR_MAX_FILE_SIZE=5242880
AVATAR_OUTPUT_SIZE=512
AVATAR_WEBP_QUALITY=85
MEDIA_BASE_URL=
# Optionaler eigener bzw. bewusst gewählter Nominatim-Dienst. Leer deaktiviert Reverse Geocoding.
NOMINATIM_BASE_URL=
NOMINATIM_USER_AGENT="OpenCityPlanner/0.1"
NOMINATIM_EMAIL=
NOMINATIM_TIMEOUT_SECONDS=5
NOMINATIM_CACHE_TTL_SECONDS=86400

# Lokale Tabelle osm_features bleibt die Primärquelle. Externen Fallback nur bewusst aktivieren.
OSM_EXTERNAL_FALLBACK_ENABLED=false
OVERPASS_API_URL=
OVERPASS_USER_AGENT="OpenCityPlanner/0.1 (https://stadtplaner.oklabflensburg.de)"
OVERPASS_TIMEOUT_SECONDS=8
OSM_LOOKUP_CACHE_TTL_SECONDS=3600
OSM_EXTERNAL_MIN_INTERVAL_SECONDS=1
OSM_LOOKUP_MAX_MATCHES=25
OSM_VIEWPORT_FEATURE_LIMIT=2000
OSM_VIEWPORT_LOW_ZOOM_FEATURE_LIMIT=800
OSM_VIEWPORT_MID_ZOOM_FEATURE_LIMIT=1200
OSM_VIEWPORT_POINT_FEATURE_LIMIT=1500
OSM_VIEWPORT_POLYGON_FEATURE_LIMIT=350
OSM_VIEWPORT_BUILDING_FEATURE_LIMIT=150

# Redis ist ein optionaler Shared-Read-Cache; PostgreSQL/PostGIS bleibt Source of Truth.
REDIS_ENABLED=true
REDIS_REQUIRED=false
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CONNECT_TIMEOUT=2
REDIS_SOCKET_TIMEOUT=2
REDIS_MAX_CONNECTIONS=40

# Pro Umgebung eindeutig setzen, z. B. stadtplaner:prod oder stadtplaner:test.
CACHE_PREFIX=stadtplaner:dev
CACHE_DEBUG_HEADERS=false
CACHE_LOCK_TTL_SECONDS=15
OSM_VIEWPORT_CACHE_TTL=1800
ANALYTICS_CACHE_TTL=600
ANALYSIS_AREA_CACHE_TTL=3600
STATISTICS_CACHE_TTL=3600
POLYGON_CACHE_TTL=60
COMPARABLE_CACHE_TTL=600
CACHE_PAYLOAD_WARNING_BYTES=2000000

DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=15

# Öffentlicher Zahlenspiegel der Stadt Flensburg. Keine Zugangsdaten erforderlich.
FLENSBURG_SUPERSET_BASE_URL=https://superset.flensburg.de
FLENSBURG_SUPERSET_DASHBOARD_ID=3b53ff0b-6e8c-435e-83f6-666f8a7cc158
FLENSBURG_SUPERSET_TIMEOUT_SECONDS=60
