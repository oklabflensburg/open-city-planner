{
  "manifest_version": 1,
  "id": "example-pois",
  "name": "Beispiel-POIs",
  "version": "1.0.0",
  "requires": {
    "host": ">=1.0.0,<2.0.0",
    "sdk": ">=1.0.0,<2.0.0"
  },
  "backend": {
    "package": "open_city_planner_example_pois"
  },
  "capabilities": [
    "map.layer",
    "map.feature-info"
  ],
  "permissions": [
    "example-pois.read"
  ],
  "config": {
    "namespace": "example-pois"
  },
  "persistence": {
    "schema": "example_pois",
    "migrations": true
  }
}
